@implements IDisposable
@inject KitchenService Kitchen
@inject ScreenSettingsService Screen
@inject NavigationManager Nav

<header class="topbar">
    <div class="topbar-left">
        <button class="topbar-menu hover-dark" @onclick="OnToggleSidebar" aria-label="Toggle sidebar" aria-controls="sidebar" aria-expanded="@(SidebarExpanded ? "true" : "false")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <h1 class="topbar-title">@Title</h1>
        @if (OnBoard)
        {
            var n = Kitchen.ActiveOrders.Count;
            var left = Kitchen.ItemsLeft;
            <p class="topbar-stats">@n order@(n == 1 ? "" : "s") · @left item@(left == 1 ? "" : "s") left</p>
        }
    </div>

    <div class="topbar-right">
        <p class="topbar-clock">@Screen.Clock(DateTimeOffset.UtcNow)</p>
        @if (OnBoard)
        {
            <button class="topbar-btn hover-dark" id="btn-recall" disabled="@(Kitchen.History.Count == 0)" @onclick="() => Kitchen.Recall()">Recall</button>
            <button class="topbar-btn topbar-btn-primary hover-dark" @onclick="Kitchen.AddTestOrder">+ Test order</button>
        }
    </div>
</header>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public bool SidebarExpanded { get; set; }

    private System.Timers.Timer? _clock;

    private string Path => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].ToLowerInvariant();
    private bool OnBoard => Path == "";

    private string Title => Path switch
    {
        "" => "Live orders",
        "recent" => "Past orders",
        "settings" => "Settings",
        _ => "Kitchen Display"
    };

    protected override void OnInitialized()
    {
        Kitchen.Changed += Refresh;
        Screen.Changed += Refresh;
        Nav.LocationChanged += OnLocationChanged;

        // the clock only shows minutes, but check every few seconds
        _clock = new System.Timers.Timer(5000);
        _clock.Elapsed += (_, _) => Refresh();
        _clock.Start();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Refresh();

    public void Dispose()
    {
        _clock?.Dispose();
        Kitchen.Changed -= Refresh;
        Screen.Changed -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
