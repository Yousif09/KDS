    <p class="sidebar-section-label">Settings &amp; Clover</p>
    <nav class="sidebar-nav">
        <NavLink class="sidebar-link" href="settings" title="Settings">
            <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true">
                <mask id="m-gear"><rect width="24" height="24" fill="#fff"/><circle cx="12" cy="12" r="3.25" fill="#000"/></mask>
					<g mask="url(#m-gear)"><circle cx="12" cy="12" r="7.5"/><rect x="10.25" y="1.75" width="3.5" height="5" rx="1.25" transform="rotate(0 12 12)"/><rect x="10.25" y="1.75" width="3.5" height="5" rx="1.25" transform="rotate(45 12 12)"/><rect x="10.25" y="1.75" width="3.5" height="5" rx="1.25" transform="rotate(90 12 12)"/><rect x="10.25" y="1.75" width="3.5" height="5" rx="1.25" transform="rotate(135 12 12)"/><rect x="10.25" y="1.75" width="3.5" height="5" rx="1.25" transform="rotate(180 12 12)"/><rect x="10.25" y="1.75" width="3.5" height="5" rx="1.25" transform="rotate(225 12 12)"/><rect x="10.25" y="1.75" width="3.5" height="5" rx="1.25" transform="rotate(270 12 12)"/><rect x="10.25" y="1.75" width="3.5" height="5" rx="1.25" transform="rotate(315 12 12)"/></g>
            </svg>
            <span class="sidebar-link-label">Settings</span>
        </NavLink>
        @* clover status, not a NavLink so it never shows as the current page *@
        <a class="sidebar-link sidebar-clover" href="settings" title="Clover: @StatusText.detail">
            <span class="sidebar-icon-wrap">
                <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.4858 2.42855C12.2057 2.19048 11.7944 2.19048 11.5143 2.42855L1.51428 10.9285C1.19867 11.1968 1.1603 11.6701 1.42856 11.9857C1.69683 12.3013 2.17015 12.3397 2.48575 12.0715L5.00002 9.93433V19C5.00002 19.5523 5.44773 20 6.00002 20H18C18.5523 20 19 19.5523 19 19V9.93433L21.5143 12.0715C21.8299 12.3397 22.3032 12.3013 22.5715 11.9857C22.8397 11.6701 22.8014 11.1968 22.4858 10.9285L12.4858 2.42855Z"/></svg>
                <span class="status-dot is-@StatusClass"></span>
            </span>
            <span class="sidebar-link-label">Clover</span>
            <span class="sidebar-status is-@StatusClass">@StatusText.label</span>
        </a>
    </nav>
    <p class="sr-only">@StatusText.detail</p>
</aside>

@code {
    private int _count;

    protected override void OnInitialized()
    {
        _count = Kitchen.ActiveOrders.Count;
        Kitchen.Changed += OnKitchenChanged;
    }

    // css classes from the original design: demo / connecting / connected / error
    private string StatusClass => Kitchen.Status switch
    {
        CloverStatus.Live => "connected",
        CloverStatus.Connecting => "connecting",
        CloverStatus.Error => "error",
        _ => "demo"
    };

    private (string label, string detail) StatusText => Kitchen.Status switch
    {
        CloverStatus.Live => ("Live", $"Connected to {Kitchen.MerchantId}"),
        CloverStatus.Connecting => ("…", "Connecting to Clover"),
        CloverStatus.Error => ("Error", Kitchen.StatusMessage ?? "Connection problem"),
        _ => ("Demo", "Clover not connected")
    };

    private void OnKitchenChanged()
    {
        _count = Kitchen.ActiveOrders.Count;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Kitchen.Changed -= OnKitchenChanged;
}
