@page "/"
@rendermode InteractiveServer
@implements IDisposable // disposes of memory that needs to be closed
@inject CloverServer CloverService

<PageTitle>Home</PageTitle>



@* If our current order is NOT null, AND if our order is showing then display all that info.
    Otherwise, showOrder is set to false and nothing appears on that conditional case.
*@
@if (CurrentOrder != null)
{
    if (showOrder)
    {

        <div class="order-card">

            <div class="order-header">

                <span class="service-type">@CurrentOrder.service</span>
                <span class="order-timer">@TotalTime</span>
                <button class="order-button" @onclick="CompleteOrder">Done</button>
            </div>

            <div class="order-body">

                @foreach (var item in CurrentOrder.items)
                {
                    <div class="order-item">
                        <div class="item-main">
                            <span class="item-qty">(@(item.quantity)) </span>
                            <span class="item-name">@item.name</span>
                        </div>



                        @if (item.modifiers.Any())
                        {
                            <ul class="item-modifiers">
                                @foreach (var modifier in item.modifiers)
                                {
                                    <li> @modifier</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>


    }
}

@code {


    private OrderCard? CurrentOrder;
    private System.Timers.Timer? _timer;
    private string TotalTime = "0:00";

    protected override async Task OnInitializedAsync()
    {


        CurrentOrder = await CloverService.GetLatestOrder(); 


        UpdateTimerDisplay();
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += ElapsedTimer;
        _timer.Start();
    }



    private void ElapsedTimer(object? sender, System.Timers.ElapsedEventArgs e)
    {
        UpdateTimerDisplay();
        InvokeAsync(StateHasChanged);
    }




    private bool showOrder = true;
    /*
     * Method to remove an order off the screen when someone clicks the "Done" button 
     */
     private void CompleteOrder()
    {
        showOrder = false;
    }



    // timer method
    private void UpdateTimerDisplay()
    {

        if(CurrentOrder == null)
        {
            return; 
        }

        var timeSpan = DateTimeOffset.UtcNow - CurrentOrder.time;

        if(timeSpan.TotalSeconds < 0)
        {
            timeSpan = TimeSpan.Zero;
        }

        TotalTime = $"{(int)timeSpan.TotalMinutes}:{timeSpan.Seconds:D2}";
    }



    // disposing of the memory allocated from the timer object. 
    public void Dispose()
    {
        _timer?.Dispose();
    }

    // represents a single order card that will pop up on the menu. 
    public class OrderCard
    {
        public DateTimeOffset time {get; set;}
        public string? service {get; set;} // to go or dine in..
        public OrderStatus orderStatus {get; set;}
        public List<OrderItem> items { get; set; } = new();  // a list of our order items
        public int itemCount {get; set;}
    }

    // class that represents a singular order item and what it will compose of
    public class OrderItem
    {
        public int quantity {get; set;}
        public string? name {get; set;}
        public List<string> modifiers { get; set; } = new(); // no tomatoes/onions .. etc
        public bool isComplete {get; set;} // is the order complete or not, if so action the button
    }


    // Enum to determine the status of an order
    public enum OrderStatus
    {
        inProgress,
        ready
    }



    // clovers response: 
    public class CloverResponse
    {
        public List<CloverOrder>Elements {get; set;} = new();
    }

    public class CloverOrder
    {
        public long createdTime {get; set;}
        public CloverOrderType? orderType {get; set;}
        public CloverLineItems? lineItems {get; set;}

    }

    public class CloverOrderType
    {
        public string? label { get; set; }
    }

    public class CloverLineItems
    {
        public List<CloverLineItem> Elements {get; set;} = new(); 
    }

    public class CloverLineItem
    {
        public string? name { get; set; }
        public string? note {get; set;} // any notes
        public int? unitQty {get; set;} 
    }

    
}
