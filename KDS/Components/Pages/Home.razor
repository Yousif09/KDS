@page "/"
@implements IAsyncDisposable // disposes of memory that needs to be closed
@inject KitchenService Kitchen
@inject ScreenSettingsService Screen
@inject IJSRuntime JS

<PageTitle>Live orders · Kitchen Display</PageTitle>

@* kds.js positions the cards into masonry columns (each card goes in the shortest column) *@
<main class="board view" @ref="_board" data-board aria-live="polite">
    @if (ActiveOrders.Any())
    {

        @foreach (var order in ActiveOrders)
        {

        
            var minutesElapsed = (_now - order.time).TotalMinutes;
            if(minutesElapsed < 35)
            {
                <OrderCardView @key="order.id" Order="order" Now="_now" />
                
            }

            
            
        }
    }
    else
    {
        <div class="board-empty">
            <p class="board-empty-title">All caught up</p>
            <p>New orders will show up here.</p>
        </div>
    }
</main>

@code {



    // Representing a singular order card

    private List<OrderCard> ActiveOrders = new();
    private System.Timers.Timer? _timer;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private ElementReference _board;

   

    protected override void OnInitialized()
    {
        LoadOrders();
        Kitchen.Changed += OnKitchenChanged;
        Screen.Changed += OnKitchenChanged;

        // initializing an order in 1 second. 
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += ElapsedTimer;
        _timer.Start();

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("KDS.board.attach", _board);
    }

    // newest orders first:
    private void LoadOrders()
    {
        ActiveOrders = Kitchen.ActiveOrders.
        OrderByDescending(o => o.time)
                          .ToList();
    }

    private void OnKitchenChanged()
    {
        InvokeAsync(() =>
        {
            LoadOrders();
            StateHasChanged();
        });
    }

    private void ElapsedTimer(object? sender, System.Timers.ElapsedEventArgs e)
    {
        // re-render every second so the timers and colors update
        InvokeAsync(() =>
        {
            _now = DateTimeOffset.UtcNow;
            StateHasChanged();
        });
    }


    // disposing of the memory allocated from the timer object.
    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        Kitchen.Changed -= OnKitchenChanged;
        Screen.Changed -= OnKitchenChanged;
        try
        {
            await JS.InvokeVoidAsync("KDS.board.detach");
        }
        catch (JSDisconnectedException)
        {
            // tab already closed
        }
    }
}
